# Telemetry configuration
# ========

RUST_LOG=info

# Database configuration
# ========

DB_DATABASE=tactica
DB_USER=tactica
DB_PASSWORD=tactica
DB_PORT=5432

# Server configuration
# ========

TACTICA_LISTEN_ADDR=0.0.0.0:8080

# Security configuration
# ========

# Generate with: openssl rand -base64 16 | tr -d '\n' | tr -d '='
TACTICA_AUTH_SALT=

# Remember to run `mise run gen-jwt-keys` to create these keys.
TACTICA_JWT_KEY_PRIV_PATH=.local/jwt.key
TACTICA_JWT_KEY_PUB_PATH=.local/jwt.pem

# ========
# INTERPOLATED VALUES BELOW, DO NOT EDIT!
# ========

TACTICA_DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_DATABASE}
