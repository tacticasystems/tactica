# Telemetry configuration
# ========

RUST_LOG=info

# Database configuration
# ========

DB_DATABASE=tactica
DB_USER=tactica
DB_PASSWORD=tactica
DB_PORT=5432

# Server configuration
# ========

TACTICA_LISTEN_ADDR=0.0.0.0:8080

# File storage (filesystem or s3)
TACTICA_FILE_BACKEND=filesystem
TACTICA_FILE_ROOT=.local/uploads
# Required for the s3 backend; the bucket must already exist and be private.
# TACTICA_S3_BUCKET=tactica-uploads
# TACTICA_S3_REGION=eu-west-2
# Garage: set TACTICA_S3_REGION=garage and AWS_ENDPOINT=https://your-garage-host
# AWS credentials are supplied through workload identity or AWS environment variables.

# Security configuration
# ========

# Generate with: openssl rand -base64 16 | tr -d '\n' | tr -d '='
TACTICA_AUTH_SALT=

# Remember to run `mise run gen-jwt-keys` to create these keys.
TACTICA_JWT_KEY_PRIV_PATH=.local/jwt.key
TACTICA_JWT_KEY_PUB_PATH=.local/jwt.pem

# ========
# INTERPOLATED VALUES BELOW, DO NOT EDIT!
# ========

TACTICA_DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_DATABASE}
