      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius,4px);font:400 14px/1.5 \"Geist Variable\",sans-serif;cursor:pointer;transition:all 150ms;background:transparent;color:var(--foreground,#252329);}.ds-button-ghost:hover{background:var(--muted,#eee8fc);}.ds-button-ghost:focus-visible{outline:2px solid var(--ring,#7955c8);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#7955c8) 50%,transparent)}.ds-button-ghost:active:not([aria-haspopup]){transform:translateY(1px)}.ds-button-ghost:disabled{pointer-events:none;opacity:.5}@media(max-width:600px){.ds-button-ghost{min-height:40px}}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition:none}}"
