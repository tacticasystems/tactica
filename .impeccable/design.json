      "css": ".ds-input{width:100%;min-height:40px;padding:9px 12px;border:1px solid var(--input,#c4bdcf);border-radius:var(--radius,4px);background:var(--surface,#fdfcfe);color:var(--foreground,#252329);font:400 14px/1.5 \"Geist Variable\",sans-serif;caret-color:var(--brand-ink,#6742b5)}.ds-input:focus-visible{outline:2px solid var(--ring,#7955c8);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#7955c8) 50%,transparent)}.ds-input:disabled{background:#f3f0f7;color:#706779}.ds-input:read-only{background:#f0edf5}.ds-input[aria-invalid=true]{border-color:var(--destructive,#9c382f)}"
